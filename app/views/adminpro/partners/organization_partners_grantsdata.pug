extends ../../layout_admin
block topmenu
  include topmenu
block content
  include submenu
  if data.length
    - var conta = 0
    each item, index in data
      if owner==item._id
        - conta++
        include grantsdata_loop
    - var conta = 1
    each item, index in data
      if owner!=item._id
        - conta++
        include grantsdata_loop
  // Modal Add Partner
  //#modalAddPartner.modal.admindevmodal.fade(tabindex='-1', role='dialog', aria-spanledby='modalAddPartnerspan', aria-hidden='true')
    .modal-dialog(role='document')
      .modal-content
        form
          input(type='hidden', name="partner_owner", value=owner)
          //input(type='hidden', name="delegate", value=user.name)
          .modal-header
            h5#modalAddPartnerspan.modal-title=__("Add partner")
            button.close(type='button', data-dismiss='modal', aria-span='Close')
              span(aria-hidden='true') ×
          .modal-body
            .alert.d-none
            .form-group
              label(for='formPartnerAddBrand')=__("Brand")
              input#formPartnerAddBrand.form-control(type='text', name="stagename", placeholder='')
            .form-group
              label(for='formPartnerAddWeb')=__("Web channels")
                !=" "
                small=__("one per line")
              textarea#formPartnerAddWeb.form-control(name="web")
            .form-group
              label(for='formPartnerAddSocial')=__("Social channels")
                !=" "
                small=__("one per line")
              textarea#formPartnerAddSocial.form-control(name="social")

          .modal-footer
            button.btn.btn-secondary(type='button', data-dismiss='modal')=__("Close")
            button.btn.btn-primary(type='submit')=__("Save")
  
  // Modal Link Partner
  //#modalLinkPartner.modal.admindevmodal.fade(tabindex='-1', role='dialog', aria-spanledby='modalLinkPartnerspan', aria-hidden='true')
    .modal-dialog(role='document')
      .modal-content
        form
          input(type='hidden', name="partner_owner", value=owner)
          //input(type='hidden', name="delegate", value=user.name)
          input(type='hidden', name="id")
          .modal-header
            h5#modalAddPartnerspan.modal-title=__("Add partner")
            button.close(type='button', data-dismiss='modal', aria-span='Close')
              span(aria-hidden='true') ×
          .modal-body
            .alert.d-none
            .form-group
              span(for='formPartnerLinkName')=__("Brand")
              input#formPartnerLinkName.form-control(type='text', name="brand", placeholder='')

          .modal-footer
            button.btn.btn-secondary(type='button', data-dismiss='modal')=__("Close")
            button.btn.btn-primary(type='submit')=__("Save")

  // Modal Add Contact
  //#modalAddContact.modal.admindevmodal.fade(tabindex='-1', role='dialog', aria-spanledby='modalAddContactspan', aria-hidden='true')
    .modal-dialog(role='document')
      .modal-content
        form
          .modal-header
            h5#modalAddPartnerspan.modal-title=__("Add contact")
            button.close(type='button', data-dismiss='modal', aria-span='Close')
              span(aria-hidden='true') ×
          .modal-body
              .form-group
                input.modal-id(type='hidden', name="crew")
                span(for='formContactAddName')=__("Name")
                input#formContactAddName.form-control(type='text', name="name", placeholder='')
              .form-group
                span(for='formContactAddSurname')=__("Surname")
                input#formContactAddSurname.form-control(type='text', name="surname", placeholder='')
              .form-group
                span(for='formContactAddEmail')=__("Email")
                input#formContactAddEmail.form-control(type='email', name="email", placeholder='name@example.com')
              .form-group
                span(for='formContactAddMobile')=__("Mobile")
                input#formContactAddMobile.form-control(type='text', name="mobile", placeholder='')
              .form-group
                span(for='formContactAddFacebook')="Facebook"
                input#formContactAddFacebook.form-control(type='text', name="facebook", placeholder='')
              .form-group
                span(for='formContactAddType')=__("Type")
                select#formContactAddType.form-control(name="type")
                  option=__("Contact")
                  option=__("Legal Rapresentative")

          .modal-footer
            button.btn.btn-secondary(type='button', data-dismiss='modal')=__("Close")
            button.btn.btn-primary(type='submit')=__("Save")

