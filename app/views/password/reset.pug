extends ../layout

block content
  .container
    .row
      .col-md-6.offset-md-3
        .pb-5
          form(method='post', action="/password/reset")
            input(type='hidden', name='token', value=token)
            .form-group
              label(for='password')=__('New Password')
              input.form-control(type='password', name='password', id='password', placeholder=__('New Password'), required)
              small=__("Password minimum length is 8 characters and have to contain at least 1 number, 1 lower case and 1 uppercase characters")
            .form-group
              label(for='retypePassword')=__('Confirm Password')
              input.form-control(type='password', name='retypePassword', id='retypePassword', placeholder=__('Confirm Password'), required)
            .form-group
              button.btn.btn-primary.btn-success(type='submit')=__('Save & Continue')
                i.icon-angle-right.fa-fw
