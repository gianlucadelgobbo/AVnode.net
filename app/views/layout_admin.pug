doctype html
html(lang=session.current_lang)
  head
    meta(charset='utf-8')
    meta(http-equiv='X-UA-Compatible', content='IE=edge')
    meta(name='viewport', content='width=device-width, initial-scale=1.0')

    title #{title} - AVnode.net
    meta(name="robots" content="index, follow")
    link(href=canonical rel="canonical")

    link(rel='shortcut icon', href='/icons/favicon.ico', type='image/x-icon')
    link(rel='apple-touch-icon', href='/icons/apple-touch-icon.png')
    link(rel='apple-touch-icon', sizes='57x57', href='/icons/apple-touch-icon-57x57.png')
    link(rel='apple-touch-icon', sizes='72x72', href='/icons/apple-touch-icon-72x72.png')
    link(rel='apple-touch-icon', sizes='76x76', href='/icons/apple-touch-icon-76x76.png')
    link(rel='apple-touch-icon', sizes='114x114', href='/icons/apple-touch-icon-114x114.png')
    link(rel='apple-touch-icon', sizes='120x120', href='/icons/apple-touch-icon-120x120.png')
    link(rel='apple-touch-icon', sizes='144x144', href='/icons/apple-touch-icon-144x144.png')
    link(rel='apple-touch-icon', sizes='152x152', href='/icons/apple-touch-icon-152x152.png')
    link(rel='apple-touch-icon', sizes='180x180', href='/icons/apple-touch-icon-180x180.png')

    link(rel='stylesheet', type='text/css', href='/css/main.min.css')
    link(rel='stylesheet', type='text/css', href='/css/admin.min.css')
    //- link(rel='stylesheet', href='/css/adminpro.css')
    if scripts && scripts.indexOf("paypal")!==-1
      script(src="https://www.paypal.com/sdk/js?client-id="+process.env.PAYPAL_CLIENT_ID+"&currency=EUR")
  body
    #top
    a#to_top.d-print-none(href="#top", title=__('Back to the top'))
      span.icon-arrow-up-circle
      span.sr-only=__('Back to the top')
    #app
      div
        if currentUrl && currentUrl.indexOf("/adminpro") == 0
          include adminpro/partials/menuHeaderAdmindev
          .container-fluid
            .row.pb-3
              .d-print-none
                include adminpro/partials/menuSuper
              .col.maincontent
                block topmenu

                include partials/flash
                .main(class=printable ? "printable" : undefined)
                  block content
                  if script
                      !=script
        else
          include admin/partials/menuHeaderAdmin
          .container-fluid
            .row.pb-3
              .d-print-none
                include admin/partials/menuSuper
              .col.maincontent
                block topmenu

                include partials/flash
                .main.mb-4
                  block content
                  if script
                      !=script


    footer
      .text-muted.text-right="AVnode.net"
    include partials/modals/modalGeneral
    include partials/modals/modalNewContent
    include partials/modals/modalForceEmailChange
    #lightGallery

    script(src='/js/combo.min.js')

    //-if scripts && scripts.indexOf("video")!==-1
      script.
        var logo_url = "!{canonical}"
      script(defer src='/js/combo_video.min.js')
    script(src='/js/combo_admin.min.js')
    if get
      script.
        var get = !{JSON.stringify(get)};
    if data && data.slug
      script.
        var slug = "#{data.slug}";
    //script(src='/js/admin_tmp.js')

    script(src="https://maps.googleapis.com/maps/api/js?key="+process.env.GOOGLEMAPSAPIKEY+"&libraries=places&language=en&callback=mapsCallback")
    
    //VJTV Calendar Only
    if calendar 
      script(src='/fullcalendar/main.min.js')
      script(src='/fullcalendar/script.js')

    script(async src="https://www.googletagmanager.com/gtag/js?id=G-DBS5WRFJ9G")
    script.
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      //-gtag('config', 'G-DBS5WRFJ9G', { 'anonymize_ip': true });
      gtag('config', 'G-DBS5WRFJ9G', {
        'client_storage': 'none', // ⛔ Non usa cookie
        'anonymize_ip': true      // ✅ Anonimizza gli IP
      });
