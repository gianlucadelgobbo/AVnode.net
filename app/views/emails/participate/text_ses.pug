each subscription in subscriptions
  if subscription.subscriber_id
    !=subscription.stagename
    br
    each day in subscription.days
      - var d = new Date(day)
      - var months = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
      - var days = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];
      != days[d.getDay()] + " " + d.getDate() + " " + months[d.getMonth()] + " " + d.getFullYear()
      br
    br
!=__('Packages')
br
br
- var total = 0;
- var conta = 0;
if event.organizationsettings.call.calls[call].packages
  each subscription, index in subscriptions
    if subscription.subscriber_id
      - var subscriber_total = 0;
      - conta = 1;
      !=conta+". "+subscription.stagename
      br
      if subscription.freezed
        !=__("This person is already in with another act and already choose his packages")
      else
        each package in subscription.packages
          - if (event.organizationsettings.call.calls[call].packages[package.id].daily)
            - total+=event.organizationsettings.call.calls[call].packages[package.id].price*subscription.days.length
            - subscriber_total+=event.organizationsettings.call.calls[call].packages[package.id].price*subscription.days.length
          - else 
            - total+=event.organizationsettings.call.calls[call].packages[package.id].price
            - subscriber_total+=event.organizationsettings.call.calls[call].packages[package.id].price
            !=event.organizationsettings.call.calls[call].packages[package.id].name + (event.organizationsettings.call.calls[call].packages[package.id].requested ? " ("+__("requested")+")" : "")
            br
            - if (event.organizationsettings.call.calls[call].packages[package.id].allow_options)
              !=event.organizationsettings.call.calls[call].packages[package.id].options_name+": "+package.option
              br
            if event.organizationsettings.call.calls[call].packages[package.id].personal && event.organizationsettings.call.calls[call].packages[package.id].daily
              !=__("per person/per day")
            else if event.organizationsettings.call.calls[call].packages[package.id].personal 
              !=__("per person")
            else if event.organizationsettings.call.calls[call].packages[package.id].daily 
              !=__("per day")
            br
            !="€ "+event.organizationsettings.call.calls[call].packages[package.id].price
            br
          if event.organizationsettings.call.calls[call].packages[package.id].daily
            if subscription.days.length = 1
              !=subscription.days.length + " " + __('day')
            else
              !=subscription.days.length + " " + __('days')
            br
            !=__("Total")
            br
            !="€ "+(event.organizationsettings.call.calls[call].packages[package.id].price*subscription.days.length)
            br
      br
      !=__('Total amount for')+" "+subscription.stagename
      br
      !="€ "+subscriber_total
      br
      br
  !=__("Amount to pay if the submission will be approved")
  !="€ "+total
