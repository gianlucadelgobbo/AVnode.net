.modal.admindevmodal.fade#msg_modal(tabindex='-1', role='dialog', aria-labelledby='myLargeModalLabel', aria-hidden='true')
  .modal-dialog.modal-lg.modal-dialog-centered
    .modal-content
      .modal-header
        h5#myLargeModalLabel.modal-title=__("Alert")
        button.close(type='button', data-dismiss='modal', aria-label='Close')
          span(aria-hidden='true') ×
      .modal-body
        p!=__("AVnode.net is now in Beta Version, feel free to test it but read the following alerts:")
        ul
          li=__("Control panel is still under development, some features are still not fully working")
        p!=__("Please send any bug and suggestion to:")+" "
          a(href="mailto:bugreports@avnode.net") bugreports@avnode.net
      .modal-footer
        button.btn.btn-default(type='button', data-dismiss='modal')=__("Cancel")
        button.btn.btn-primary.modal-confirm(type='button', data-dismiss='modal')=__("I have read, continue")
