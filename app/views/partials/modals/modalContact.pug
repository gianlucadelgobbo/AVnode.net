.modal.fade#modalContact(tabindex='-1', role='dialog', aria-labelledby='myLargeModalLabel', aria-hidden='true')
  .modal-dialog.modal-lg.modal-dialog-centered
    .modal-content
      .modal-header
        h5#myLargeModalLabel.modal-title=__("Contact")
        button.close(type='button', data-dismiss='modal', aria-label='Close')
          span(aria-hidden='true') ×
      .modal-body
        .alert.d-none
        if user
          form
            .form-group
              !=__("From")+": "
              b=user.stagename
            .form-group
              !=__("Subject")+": "
              b=__("Contact request for")+" "+data.stagename
              input(type="hidden", name="user", value=data._id)
              input(type="hidden", name="subject", value="Contact request for "+data.stagename)
            .form-group
              label(for='message')=__("Message")
              textarea#message.form-control(name="message", rows='10')
                !=__("Dear")+" "+data.stagename+",\n"
                !=__("I'm")+" "+user.stagename+",\n\n"
                !=__("Best regards")+"\n\n"
                !=user.stagename
      .modal-footer
        button.btn.btn-secondary(type='button', data-dismiss='modal')=__("cancel")
        button.btn.btn-primary(type='button')=__("SEND")
