.modal.fade#modalBookPerf(tabindex='-1', role='dialog', aria-labelledby='myLargeModalLabel', aria-hidden='true')
  .modal-dialog.modal-lg.modal-dialog-centered
    .modal-content
      .modal-header
        h5#myLargeModalLabel.modal-title=__("Booking request")
        button.close(type='button', data-dismiss='modal', aria-label='Close')
          span(aria-hidden='true') ×
      .modal-body
        .alert.d-none
        if user
          form
            .form-group
              !=__("From")+": "
              b=user.stagename
            .form-group
              !=__("Subject")+": "
              b=__("Booking request for")+" "+data.title
              input(type="hidden", name="perf", value=data._id)
              input(type="hidden", name="subject", value="Booking request for "+data.title)
            .form-group
              label(for='organisation')=__("Organisation")+" ("+__("Crew")+") "+": "
              if user.crews
                select#organisation.form-control(name="crew")
                  option=__("Please select an organisation")
                  each crew in user.crews
                    option=crew.stagename
              else 
                p=__("Please create a crew")
            .form-group
              label(for="request")=__("Booking request")
              textarea#request.form-control(name="request", rows='10')
                !=__("Dear")+" "+data.users[0].stagename+",\n"
                !=__("I'm")+" "+user.stagename+", "+__("we would like to book")+" \""+data.title+"\", "+__("are you interested?")+"\n\n"
                !=__("Best regards")+"\n\n"
                !=user.stagename
      .modal-footer
        button.btn.btn-secondary(type='button', data-dismiss='modal')=__("cancel")
        button.btn.btn-primary(type='button')=__("SEND")
