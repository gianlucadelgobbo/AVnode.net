nav.navbar.navbar_extended_template.navbar-toggleable-md.navbar-fixed-top.navbar-inverse.bg-inverse.navbar-expand-lg 
  .container
    button.navbar-toggler.navbar-toggler-right(type="button", data-toggle="collapse", data-target="#navbar-collapse_performer_template")
      span.sr-only=__("Open menu")
      i.icon-menu.toggle_icon
    a.navbar-brand(href='/', title="AVnode.net")
      img(src='/images/logo_avnode_bar.svg', class='main_logo' alt='AVnode.net', width="300", height="123")

    .collapse.navbar-collapse#navbar-collapse_performer_template
      include menuSections
      ul.user_navbar.navbar-nav
        li.dropdown.mt-1.mr-2#dropdownContents(class=["ru", "de", "es", "fr", "pt"].indexOf(session.current_lang)!==-1 ? "d-md-block d-lg-none d-xl-block" : "")
          button#dropdownMenuContents.btn.btn-primary.btn-sm.dropdown-toggle(type='button', data-toggle='dropdown', aria-haspopup='true', aria-expanded='false')=__('New content')+" "
          .dropdown-menu(aria-labelledby='dropdownMenuContents')
            a.dropdown-item(href='#'
              data-labelfield=__("Performance Name")
              data-title=__("Add Performance")
              data-user=user && user._id ? user._id : undefined
              data-param="title"
              data-sez="performances")=__('New Performance')
            a.dropdown-item(href='#'
              data-labelfield=__("Video Title")
              data-title=__("Add VJ Television Video")
              data-param="title"
              data-user=user && user._id ? user._id : undefined
              data-sez="videos")=__('New VJ Television Video')
            a.dropdown-item(href='#'
              data-labelfield=__("Learning Title")
              data-title=__("Add Learning")
              data-param="title"
              data-user=user && user._id ? user._id : undefined
              data-sez="performances")=__('New Learning')
            a.dropdown-item(href='#'
              data-labelfield=__("Event Name")
              data-title=__("Add Event")
              data-param="title"
              data-user=user && user._id ? user._id : undefined
              data-sez="events")=__('New Event')
            a.dropdown-item(href='#'
              data-labelfield=__("News Title")
              data-title=__("Add News")
              data-param="title"
              data-user=user && user._id ? user._id : undefined
              data-sez="news")=__('New News')
            .dropdown-divider
            a.dropdown-item(href='#'
              data-labelfield=__("Video Title")
              data-title=__("Add Video")
              data-param="title"
              data-user=user && user._id ? user._id : undefined
              data-sez="videos")=__('New Video')
            a.dropdown-item(href='#'
              data-labelfield=__("Gallery Name")
              data-title=__("Add Gallery")
              data-param="title"
              data-user=user && user._id ? user._id : undefined
              data-sez="galleries")=__('New Gallery')
            a.dropdown-item(href='#'
              data-labelfield=__("Crew Name")
              data-title=__("Add Crew")
              data-param="stagename"
              data-user=user && user._id ? user._id : undefined
              data-sez="crews")=__('New Crew')
            a.dropdown-item(href='#'
              data-labelfield=__("Organization Name")
              data-title=__("Add Organization")
              data-param="stagename"
              data-user=user && user._id ? user._id : undefined
              data-sez="crews")=__('New Organization')
            a.dropdown-item(href='#'
              data-labelfield=__("Footage Title")
              data-title=__("Add Footage")
              data-param="title"
              data-user=user && user._id ? user._id : undefined
              data-sez="footage")=__('New Footage')
            a.dropdown-item(href='#'
              data-labelfield=__("Playlist Name")
              data-title=__("Add Playlist")
              data-param="title"
              data-user=user && user._id ? user._id : undefined
              data-sez="playlist")=__('New Playlist')

        if user
          //li.nav-item.dropdown.user_menu.user_menu_logged                  
          li.nav-item.dropdown.user_menu.user_menu_logged
            a#userDropdown.nav-link.dropdown-toggle(href='#', role='button', data-toggle='dropdown', aria-haspopup='true', aria-expanded='false')
              i.icon-user-outline
              span.sr-only=__("User Menu")
            .dropdown-menu.dropdown-menu-right(aria-labelledby='userDropdown')
              a.dropdown-item(href='/'+user.slug)                    
                i.pr-2.icon-eye
                !=" "+__('Profile')
              a.dropdown-item(href='/admin/profile/'+user._id+'/public')                    
                i.pr-2.icon-cog-outline
                !=" "+__('Control Panel')
              a.dropdown-item(href='/logout')                    
                i.pr-2.icon-exit
                !=" "+__('Log out')
        else
          //-li.nav-item.signup_ico
            a.nav-link.disabled(href='#')
              i.pr-2.icon-user-outline
          li.nav-item.login
            a.nav-link(href="/login?returnTo="+canonical, title=__('Login'))
              !=__('Login')
          li.nav-item.signup
            a.nav-link(href='/signup', title=__('Sign up'))=__('Sign up')
        li.nav-item.search
          if url && url.indexOf("/search")===0
            a.nav-link(href='#')
              i.icon-search.fa-lg.fa-fw
          else
            a.nav-link(href='#searchbar', title=__('Search'), data-toggle="collapse", role="button", aria-expanded="false", aria-controls="searchbar")
              i.icon-search.fa-lg.fa-fw
        li.nav-item.dropdown.mt-2.ml-1.lang
          a#langDropdown.dropdown-toggle(href='#', role='button', data-toggle='dropdown', aria-haspopup='true', aria-expanded='false')
            b=session.current_lang.toUpperCase()
          .dropdown-menu.dropdown-menu-right(aria-labelledby='langDropdown')
            - var base = canonical.replace("http://", "").replace("https://", "").split(".")
            - if (base[0].length==2) base.shift()   
            - var base1 = base.join(".")
            each lang,slug in config.locales_labels
              a.dropdown-item(href='//'+(slug!='en' ? config.lang_to_domain[slug]+'.' : '')+base1 class=slug==session.current_lang ? 'disabled' : '')=lang